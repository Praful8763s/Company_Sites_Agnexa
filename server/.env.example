# =================================================================
# Agnexa Technologies - Production Backend Environment Configuration
# =================================================================

# Server Port (Render / Railway / Heroku inject PORT automatically)
PORT=5000

# Environment Mode: 'development' | 'production'
NODE_ENV=production

# Frontend Client URL(s) for CORS Authorization
# In production, set this to your deployed frontend domain
CLIENT_URL=https://agnexa.com
FRONTEND_URL=https://agnexa-client.vercel.app
ALLOWED_ORIGINS=https://agnexa.com,https://www.agnexa.com,https://agnexa-client.vercel.app

# JWT Security Secrets (Generate a 64+ char random string for production)
JWT_SECRET=agnexa_super_secure_enterprise_jwt_secret_token_2026_production
JWT_EXPIRE=30d

# =================================================================
# Database Configuration (Multi-Provider: PostgreSQL / Supabase / In-Memory)
# =================================================================
# Option 1: Direct Native PostgreSQL Connection (Recommended for highest performance)
# Works directly with Supabase Postgres, Render Postgres, AWS RDS, Neon, Railway:
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# With connection pooling (Transaction Mode):
# Format: postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:Agnexia@999s@db.your-project-id.supabase.co:5432/postgres
POSTGRES_URL=

# Option 2: Supabase REST API Client (Serverless)
# In Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =================================================================
# Email Notifications Configuration (Routing to prafulsonwane58@gmail.com)
# =================================================================
ADMIN_EMAIL=prafulsonwane58@gmail.com

# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste below:
EMAIL_USER=prafulsonwane58@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

